{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lexintel-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "3005"
      ],
      "port": 3005
    },
    {
      "name": "lexintel-space",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "vite",
        "preview",
        "frontend",
        "--outDir",
        "../dist-space",
        "--port",
        "3015",
        "--strictPort"
      ],
      "port": 3015
    }
  ]
}