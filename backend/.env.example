# Copy to .env. Values below are for `docker compose` (service hostnames).
# Never commit the real .env.

# --- Security ---
# Signs login tokens and keys complaint tracking codes (changing it signs everyone
# out and invalidates existing tracking codes).
# Generate a real one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3005
ENVIRONMENT=development
# ACCESS_TOKEN_EXPIRE_MINUTES=480
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# --- Local AI (everything runs on this machine; no cloud AI, no API key) ---
# Writing model for research drafts and case briefs, served by the ollama
# container. First run: docker compose exec ollama ollama pull qwen2.5:1.5b-instruct
# LLM_PROVIDER=none switches drafting off; every other AI feature keeps working.
LLM_PROVIDER=ollama               # ollama | none
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct  # qwen2.5:3b-instruct writes better but needs ~2.5 GB more RAM
# OLLAMA_KEEP_ALIVE=5m            # unload the writing model after this much idle time
# MODEL_IDLE_UNLOAD_SECONDS=600   # same for the embedding and speech-to-text models
# EMBEDDINGS_ENABLED=true

# --- Data stores ---
POSTGRES_URL=postgresql://lexintel:lexintel@postgres:5432/lexintel
MONGO_URL=mongodb://mongo:27017/lexintel
REDIS_URL=redis://redis:6379/0
ELASTICSEARCH_URL=http://elasticsearch:9200
NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-too

# --- Files, speech-to-text, law library ---
UPLOAD_DIR=/data/uploads
WHISPER_MODEL=base                # tiny | base | small (bigger = better + more RAM)
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# SPACY_MODEL=en_core_web_sm
# Absolute: the API runs from the source folder so its file watcher stays small.
FAISS_INDEX_PATH=/app/data/faiss_uae_law_index

# --- Switch optional services off (the app uses its fallbacks) ---
# ELASTICSEARCH_ENABLED=false
# NEO4J_ENABLED=false
# CELERY_ENABLED=false
# WHISPER_ENABLED=false
